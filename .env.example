# Copy this file to ".env". Restart "npm run dev" after a change.
#
# WARNING: every VITE_ value is built into the app and anyone can read it in the browser.
# Never put passwords, tokens or the database address here.

# Where the app sends its API requests.
#   /api                            recommended: same address as the app
#   https://api.example.com/api     only if the API has its own address on the SAME main domain
# It is read when the app is built: build again after changing it.
VITE_API_BASE_URL=/api

# Development and preview only (not built into the app):
# where "/api" requests are forwarded.
API_PROXY_TARGET=http://localhost:5000
